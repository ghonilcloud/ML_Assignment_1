    "target_column = \"CO(GT)\"\n",
    "\n",
    "columns_to_exclude = [\n",
    "    \"Date\",\n",
    "    \"Time\",\n",
    "    \"NMHC(GT)\",\n",
    "    \"C6H6(GT)\",\n",
    "    \"NOx(GT)\",\n",
    "    \"NO2(GT)\",\n",
    "]\n",
    "\n",
    "required_columns = [target_column, *columns_to_exclude]\n",
    "missing_columns = [column for column in required_columns if column not in data.columns]\n",
    "\n",
    "if missing_columns:\n",
    "    raise ValueError(f\"Expected columns not found in the dataset: {missing_columns}\")\n",
    "\n",
    "rows_before = len(data)\n",
    "data = data.loc[data[target_column].notna()].copy()\n",
    "rows_removed = rows_before - len(data)\n",
    "\n",
    "X = data.drop(columns=[target_column, *columns_to_exclude])\n",
    "y = data[target_column]\n",
    "\n",
    "print(\"Target:\", target_column)\n",
    "print(\"Predictor columns:\", X.columns.tolist())\n",
    "print(\"Feature matrix shape:\", X.shape)\n",
    "print(\"Target shape:\", y.shape)\n",
    "print(\"Rows with missing target removed:\", rows_removed)\n",
    "\n",
    "display(X.describe().T.round(2))\n",
    "display(y.describe().to_frame(name=\"CO(GT) summary\").round(2))"
   ]
  },
