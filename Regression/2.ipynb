    "from matplotlib.colors import LinearSegmentedColormap\n",
    "\n",
    "correlation_data = X.copy()\n",
    "correlation_data[target_column] = y\n",
    "correlation_matrix = correlation_data.corr(numeric_only=True)\n",
    "\n",
    "# The matrix is symmetric with 1s on the diagonal, so only the lower triangle is drawn.\n",
    "# CO(GT) is the bottom row: it shows each predictor's correlation with the target.\n",
    "lower = correlation_matrix.iloc[1:, :-1]\n",
    "size = len(lower)\n",
    "upper_mask = np.triu(np.ones((size, size), dtype=bool), k=1)\n",
    "\n",
    "# Diverging scale: blue (negative), neutral gray (zero), red (positive).\n",
    "diverging = LinearSegmentedColormap.from_list(\n",
    "    \"blue_gray_red\", [\"#104281\", \"#6da7ec\", \"#f0efec\", \"#ef8f8e\", \"#a32b2b\"]\n",
    ")\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(8.5, 7.2))\n",
    "mesh = ax.pcolormesh(\n",
    "    np.ma.masked_array(lower.to_numpy(), upper_mask),\n",
    "    cmap=diverging, vmin=-1, vmax=1, edgecolors=\"white\", linewidth=2,\n",
    ")\n",
    "ax.invert_yaxis()\n",
    "\n",
    "for row in range(size):\n",
    "    for col in range(row + 1):\n",
    "        value = lower.iat[row, col]\n",
    "        ax.text(\n",
    "            col + 0.5, row + 0.5, f\"{value:.2f}\",\n",
    "            ha=\"center\", va=\"center\", fontsize=9,\n",
    "            color=\"white\" if abs(value) >= 0.7 else \"#0b0b0b\",\n",
    "            fontweight=\"bold\" if lower.index[row] == target_column else \"normal\",\n",
    "        )\n",
    "\n",
    "ax.set_xticks(np.arange(size) + 0.5, lower.columns, rotation=45, ha=\"right\")\n",
    "ax.set_yticks(np.arange(size) + 0.5, lower.index)\n",
    "for label in ax.get_yticklabels():\n",
    "    if label.get_text() == target_column:\n",
    "        label.set_fontweight(\"bold\")\n",
    "ax.tick_params(length=0, colors=\"#52514e\")\n",
    "for spine in ax.spines.values():\n",
    "    spine.set_visible(False)\n",
    "ax.set_title(\n",
    "    f\"Pearson correlation between predictors and CO(GT) ({len(correlation_data):,} rows)\",\n",
    "    loc=\"left\", fontsize=12, color=\"#0b0b0b\",\n",
    ")\n",
    "\n",
    "colorbar = fig.colorbar(mesh, ax=ax, shrink=0.8, pad=0.02)\n",
    "colorbar.set_label(\"Pearson r\", color=\"#52514e\")\n",
    "colorbar.outline.set_visible(False)\n",
    "colorbar.ax.tick_params(length=0, colors=\"#52514e\")\n",
    "\n",
    "fig.tight_layout()\n",
    "fig.savefig(\"fig_R5_correlation_heatmap.png\", dpi=200, bbox_inches=\"tight\")\n",
    "plt.show()"
   ]
  },
