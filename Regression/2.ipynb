    "# Training-set views of the target, used in the report.\n",
    "# Only the training split is plotted so the test set stays unseen.\n",
    "print(f\"Training CO(GT) median: {y_train.median():.1f} mg/m³, max: {y_train.max():.1f} mg/m³\")\n",
    "\n",
    "fig, ax = plt.subplots(figsize=(14, 3))\n",
    "ax.hist(y_train, bins=30, edgecolor=\"black\")\n",
    "ax.set_title(\"Target distribution in the training set: CO(GT)\")\n",
    "ax.set_xlabel(\"CO concentration (mg/m³)\")\n",
    "ax.set_ylabel(\"Number of observations\")\n",
    "fig.tight_layout()\n",
    "plt.show()\n",
    "\n",
    "training_correlations = X_train.corrwith(y_train)\n",
    "display(training_correlations.round(2).to_frame(name=\"Pearson r with CO(GT), training set\"))\n",
    "\n",
    "fig, axes = plt.subplots(2, 4, figsize=(20, 9))\n",
    "for ax, column in zip(axes.flat, X_train.columns):\n",
    "    ax.scatter(X_train[column], y_train, s=4, alpha=0.3)\n",
    "    ax.set_title(f\"Training set: {column} vs target (r = {training_correlations[column]:.2f})\", fontsize=10)\n",
    "    ax.set_xlabel(column)\n",
    "    ax.set_ylabel(\"CO(GT) (mg/m³)\")\n",
    "fig.suptitle(\"Target relationship across training feature values\")\n",
    "fig.tight_layout()\n",
    "plt.show()"
   ]
  },
