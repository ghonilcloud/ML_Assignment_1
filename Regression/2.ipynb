    "# Same four methods on the other air-quality labels.\n",
    "# `data` was filtered on CO(GT) in cell 3, so reload the spreadsheet to keep rows where only CO is missing.\n",
    "# PT08.S5(O3) is a sensor response: the dataset has no reference O3 column.\n",
    "# CO(GT) is not repeated here because cells 12 and 13 already report it.\n",
    "from sklearn.base import clone\n",
    "from sklearn.compose import TransformedTargetRegressor\n",
    "\n",
    "all_labels = pd.read_excel(\"RegData.xlsx\").replace(-200, np.nan)\n",
    "candidate_features = X.columns.tolist()\n",
    "\n",
    "other_labels = {\n",
    "    \"NMHC(GT)\": \"NMHC (µg/m³)\",\n",
    "    \"NO2(GT)\": \"NO2 (µg/m³)\",\n",
    "    \"PT08.S5(O3)\": \"O3 sensor response\",\n",
    "}\n",
    "\n",
    "label_results = []\n",
    "label_tests = {}\n",
    "\n",
    "for label in other_labels:\n",
    "    label_data = all_labels.loc[all_labels[label].notna()]\n",
    "    label_X = label_data[[column for column in candidate_features if column != label]]\n",
    "    label_y = label_data[label]\n",
    "\n",
    "    label_X_train, label_X_test, label_y_train, label_y_test = train_test_split(\n",
    "        label_X,\n",
    "        label_y,\n",
    "        test_size=0.2,\n",
    "        random_state=random_state,\n",
    "    )\n",
    "\n",
    "    label_predictions = {}\n",
    "\n",
    "    for model_name, model in models.items():\n",
    "        # These targets run into the hundreds, so the fixed SVR C and epsilon underfit and the\n",
    "        # MLP stops at max_iter unless the target is standardised during fitting.\n",
    "        # Predictions are converted back, so MSE stays in the label's original units.\n",
    "        estimator = TransformedTargetRegressor(\n",
    "            regressor=Pipeline([\n",
    "                (\"imputer\", SimpleImputer(strategy=\"median\")),\n",
    "                (\"scaler\", StandardScaler()),\n",
    "                (\"model\", clone(model)),\n",
    "            ]),\n",
    "            transformer=StandardScaler(),\n",
    "        )\n",
    "\n",
    "        scores = cross_validate(\n",
    "            estimator,\n",
    "            label_X_train,\n",
    "            label_y_train,\n",
    "            cv=cross_validation,\n",
    "            scoring={\"mse\": \"neg_mean_squared_error\", \"r2\": \"r2\"},\n",
    "        )\n",
    "\n",
    "        estimator.fit(label_X_train, label_y_train)\n",
    "        predictions = estimator.predict(label_X_test)\n",
    "        label_predictions[model_name] = predictions\n",
    "\n",
    "        label_results.append({\n",
    "            \"Label\": label,\n",
    "            \"Model\": model_name,\n",
    "            \"Training rows\": len(label_y_train),\n",
    "            \"Test rows\": len(label_y_test),\n",
    "            \"Mean CV MSE\": -scores[\"test_mse\"].mean(),\n",
    "            \"Mean CV R²\": scores[\"test_r2\"].mean(),\n",
    "            \"CV R² standard deviation\": scores[\"test_r2\"].std(),\n",
    "            \"Test MSE\": mean_squared_error(label_y_test, predictions),\n",
    "            \"Test R²\": r2_score(label_y_test, predictions),\n",
    "        })\n",
    "\n",
    "    label_tests[label] = (label_y_test, label_predictions)\n",
    "\n",
    "label_table = pd.DataFrame(label_results).set_index([\"Label\", \"Model\"]).round(4)\n",
    "display(label_table)\n"
