    "# Actual vs. predicted for every model and label.\n",
    "# Axes are shared along each row so the models can be compared directly.\n",
    "# The CO(GT) row reuses the cell 13 predictions and the other rows reuse cell 17, so no model is refitted.\n",
    "all_panels = {\n",
    "    \"CO(GT)\": (\"CO (mg/m³)\", y_test, test_predictions),\n",
    "}\n",
    "\n",
    "for label, axis_name in other_labels.items():\n",
    "    label_y_test, label_predictions = label_tests[label]\n",
    "    all_panels[label] = (axis_name, label_y_test, label_predictions)\n",
    "\n",
    "fig, axes = plt.subplots(len(all_panels), len(models), figsize=(16, 16.5))\n",
    "\n",
    "for row_axes, (label, (axis_name, actual, predictions_by_model)) in zip(axes, all_panels.items()):\n",
    "    minimum_value = min(actual.min(), *(values.min() for values in predictions_by_model.values()))\n",
    "    maximum_value = max(actual.max(), *(values.max() for values in predictions_by_model.values()))\n",
    "    margin = 0.04 * (maximum_value - minimum_value)\n",
    "    limits = (minimum_value - margin, maximum_value + margin)\n",
    "\n",
    "    for ax, model_name in zip(row_axes, models):\n",
    "        predicted = predictions_by_model[model_name]\n",
    "\n",
    "        ax.scatter(actual, predicted, s=9, alpha=0.4, color=\"#2a78d6\", linewidths=0)\n",
    "        ax.plot(limits, limits, color=\"#444444\", linestyle=\"--\", linewidth=1)\n",
    "        ax.set_xlim(limits)\n",
