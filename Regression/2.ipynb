    "models = {\n",
    "    \"Linear Regression\": LinearRegression(),\n",
    "    \"Support Vector Regression\": SVR(kernel=\"rbf\", C=1.0, epsilon=0.1),\n",
    "    \"Decision Tree Regressor\": DecisionTreeRegressor(\n",
    "        max_depth=10,\n",
    "        random_state=random_state,\n",
    "    ),\n",
    "    \"MLP Regressor\": MLPRegressor(\n",
    "        hidden_layer_sizes=(100,),\n",
    "        activation=\"relu\",\n",
    "        solver=\"adam\",\n",
    "        max_iter=1000,\n",
    "        random_state=random_state,\n",
    "    ),\n",
    "}\n",
    "\n",
    "def make_model_pipeline(model):\n",
    "    return Pipeline([\n",
    "        (\"imputer\", SimpleImputer(strategy=\"median\")),\n",
    "        (\"scaler\", StandardScaler()),\n",
    "        (\"model\", model),\n",
    "    ])\n",
    "\n",
    "cross_validation = KFold(\n",
    "    n_splits=5,\n",
    "    shuffle=True,\n",
    "    random_state=random_state,\n",
    ")\n",
    "\n",
    "cv_results = []\n",
    "\n",
    "for model_name, model in models.items():\n",
    "    scores = cross_validate(\n",
    "        make_model_pipeline(model),\n",
    "        X_train,\n",
    "        y_train,\n",
    "        cv=cross_validation,\n",
    "        scoring={\n",
    "            \"mse\": \"neg_mean_squared_error\",\n",
    "            \"mae\": \"neg_mean_absolute_error\",\n",
    "            \"r2\": \"r2\",\n",
    "        },\n",
    "    )\n",
    "\n",
    "    fold_mse = -scores[\"test_mse\"]\n",
    "    fold_mae = -scores[\"test_mae\"]\n",
    "    fold_rmse = np.sqrt(fold_mse)\n",
    "    fold_r2 = scores[\"test_r2\"]\n",
    "\n",
    "    cv_results.append({\n",
    "        \"Model\": model_name,\n",
    "        \"Mean CV MSE\": fold_mse.mean(),\n",
    "        \"CV MSE standard deviation\": fold_mse.std(),\n",
    "        \"Mean CV RMSE\": fold_rmse.mean(),\n",
    "        \"CV RMSE standard deviation\": fold_rmse.std(),\n",
    "        \"Mean CV MAE\": fold_mae.mean(),\n",
    "        \"Mean CV R2\": fold_r2.mean(),\n",
    "        \"CV R2 standard deviation\": fold_r2.std(),\n",
    "    })\n",
    "\n",
    "cv_table = pd.DataFrame(cv_results).set_index(\"Model\").round(4)"
